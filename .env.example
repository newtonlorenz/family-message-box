HOST=127.0.0.1
PORT=8787
# Docker host-side bind. Set this to the server's fixed private LAN address;
# do not use 0.0.0.0 and do not port-forward this service from the router.
FAMILY_BOX_BIND_IP=127.0.0.1
DATABASE_PATH=./data/family-box.db
AUDIO_DIR=./data/audio
DEVICE_BOOTSTRAP_TOKEN=change-this-before-lan-use
# Loopback development seeds family-box-01 automatically. Non-loopback hosts
# require device registration and never seed the known development credential.
# mock or twilio-whatsapp. The WhatsApp Web prototype source is retained for
# contributors but its currently vulnerable browser dependency is not bundled.
MESSAGING_ADAPTER=mock
MOCK_ADAPTER=true
FFMPEG_PATH=ffmpeg
MAX_UPLOAD_BYTES=5000000
# Wi-Fi firmware updates are disabled until a strong admin token and ECDSA
# public key are configured. `node scripts/configure-firmware-ota.mjs` creates
# an ignored private signing key and fills these local values without printing
# the token. Keep the private key off the ESP32 and out of Docker.
FIRMWARE_DIR=./data/firmware
MAX_FIRMWARE_BYTES=6553600
# FIRMWARE_ADMIN_TOKEN=replace-with-a-long-random-token
# FIRMWARE_SIGNING_PUBLIC_KEY_PATH=./data/firmware-signing-public.pem
# Prefer HTTPS. This explicit override is only for an accepted private-LAN
# development setup and does not protect device credentials from Wi-Fi capture.
ALLOW_INSECURE_LAN_OTA=false
ADMIN_ORIGIN=http://127.0.0.1:5173
# Optional direct HTTPS for the physical device and production-style admin UI.
# Set both paths together. The server certificate must include the LAN hostname
# or IP used by the ESP32, whose config embeds only the matching root CA.
# TLS_CERT_PATH=./.certs/lan-server.crt
# TLS_KEY_PATH=./.certs/lan-server.key
# Shared Twilio WhatsApp Sandbox sender. Production requires a dedicated sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional Sandbox mode: sends this approved template until an inbound reply
# opens the 24-hour conversation window, then sends recorded audio via MediaUrl.
# TWILIO_CONTENT_SID=HX...
# Keep credentials only in .env; never commit them.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Public HTTPS origin that forwards to this server. Twilio fetches outbound
# audio here and posts incoming WhatsApp messages to /api/twilio/webhook.
# TWILIO_PUBLIC_BASE_URL=https://your-tunnel-or-domain.example
# Set only when a reverse proxy changes the exact URL Twilio signs.
# TWILIO_WEBHOOK_URL=https://your-tunnel-or-domain.example/api/twilio/webhook
